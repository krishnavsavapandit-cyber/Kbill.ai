# ==============================================================================
# BusinessOS AI - Production Configuration
# ==============================================================================

# Database
# Default: SQLite (Embedded, zero external dependencies required for local run)
# For Supabase / Postgres: Change provider in prisma/schema.prisma to "postgresql" and set:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# Public App Base URL (used for booking links, public quotation views, webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Token Secret (Minimum 32 characters, generated randomly)
AUTH_SECRET="your-32-character-or-longer-random-secret-key-here"

# AI Provider (Google Gemini API)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=""

# Optional secondary AI fallback
OPENAI_API_KEY=""

# Meta WhatsApp Business Cloud API
# Official Portal: https://developers.facebook.com/apps/
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
META_WA_BUSINESS_ACCOUNT_ID=""
META_WA_WEBHOOK_VERIFY_TOKEN="businessos_webhook_token_2026"
META_WA_APP_SECRET=""

# Razorpay Payment Gateway (Indian Businesses)
# Portal: https://dashboard.razorpay.com/#/access/api-keys
# Test Mode prefix: rzp_test_... | Live Mode prefix: rzp_live_...
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMTP Email (Optional for Quotation / Invoice PDF emailing & booking reminders)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@businessos.ai"
